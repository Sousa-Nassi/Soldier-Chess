rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global safety net - Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PRIMITIVES & HELPERS ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- ENTITY VALIDATION ---
    function isValidRoom(data) {
      return data.fen is string && data.fen.size() <= 200 &&
             data.whitePlayer is string && data.whitePlayer.size() <= 128 &&
             data.status in ['waiting', 'active', 'finished'] &&
             data.turn in ['w', 'b'] &&
             (data.keys().hasAll(['blackPlayer']) ? (data.blackPlayer is string || data.blackPlayer == null) : true);
    }

    function isValidMessage(data) {
      return data.userId == request.auth.uid &&
             data.text is string && data.text.size() <= 500 &&
             data.createdAt == request.time &&
             data.userName is string && data.userName.size() <= 100;
    }

    // --- MATCH BLOCKS ---
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
                      isValidId(roomId) &&
                      isValidRoom(incoming()) &&
                      incoming().whitePlayer == request.auth.uid &&
                      incoming().status == 'waiting' &&
                      incoming().createdAt == request.time;

      allow update: if isSignedIn() &&
                      isValidRoom(incoming()) &&
                      // Prevent changes if game is finished (Terminal State Locking)
                      existing().status != 'finished' &&
                      // Ensure immutable fields
                      incoming().whitePlayer == existing().whitePlayer &&
                      incoming().createdAt == existing().createdAt && (
                        // Action Join
                        (existing().status == 'waiting' && 
                         incoming().diff(existing()).affectedKeys().hasOnly(['blackPlayer', 'blackEmail', 'status', 'lastMoveAt'])) ||
                        
                        // Action Move
                        (existing().status == 'active' && 
                         (request.auth.uid == existing().whitePlayer || request.auth.uid == existing().blackPlayer) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['fen', 'turn', 'lastMoveAt']))
                      );
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.whitePlayer ||
          request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.blackPlayer
        );
        allow create: if isSignedIn() && 
                        isValidId(messageId) &&
                        isValidMessage(incoming());
      }
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && (
        !incoming().keys().hasAny(['role', 'isAdmin', 'rank']) || 
        incoming().rank == existing().rank // Only system can change rank (mock logic)
      );
    }
  }
}
